[init]
	defaultBranch = main
[user]
	name = Matthew Boston
	email = matthew@matthewboston.com
	signingkey = ~/.ssh/git-signing-ed25519
[github]
	user = bostonaholic
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[help]
	autocorrect = 1
[color]
	ui = auto
[commit]
	verbose = true
	gpgsign = true
[core]
	editor = vim
	logAllRefUpdates = always
[diff]
	renames = true
	noprefix = true
[fetch]
	prune = true
[merge]
    conflictstyle = zdiff3
	ff = only
[push]
	autoSetupRemote = true
[pull]
	default = tracking
	tags = true
	rebase = true
[rebase]
	autosquash = true
	autostash = true
[rerere]
	autoupdate = true
	enabled = true
[remote "origin"]
	prune = true
[alias]
	aa = add --all
	ap = add --patch

	br = branch
	bra = branch --all
	bd = branch --delete
	bdd = branch --delete --force

	amend = commit --amend
	cb = clone-bare-for-worktrees
	cl = clone
	cm = commit --message
	aic = !git-ai-commit
	co = checkout
	pu = push

	di = diff

	l = "!. $HOME/.config/git/helpers && pretty_git_log"
	recent = "!f() { GIT_NO_PAGER=1 git l -${1:-10}; }; f"
	r = !git recent $1

	st = status --short --branch
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[tag]
	# GPG sign annotated tags by default
	forceSignAnnotated = true
[includeIf "gitdir:~/code/work/"]
	path = config.work
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
