# Ruby #
#######
.bundle/
vendor/

# Git worktrees #
#################
.worktrees/

# tmux plugins (installed by TPM) #
####################################
tmux/plugins/

# Third-party agent skills #
############################
# agents/skills is symlinked to ~/.claude/skills and ~/.agents/skills, so
# 'npx skills add -g' writes upstream skills straight into this repo. They are
# declared in packages.agent_skills; scripts/install_agent_skills reinstalls
# them. Track the declaration, not the vendored copy.
agents/skills/create-agentsmd/
agents/skills/find-skills/
agents/skills/first-principles-thinking/
agents/skills/frontend-design/
agents/skills/grill-me/
agents/skills/humanizer/
agents/skills/skill-creator/

# Skills vendored by the cloudflare Claude Code plugin #
########################################################
# Identical copies of the skills shipped by cloudflare@cloudflare (declared in
# packages.claude.plugins). 'npx skills add -g' / the plugin write through the
# ~/.claude/skills symlink into this repo. Track the plugin, not the copy.
agents/skills/agents-sdk/
agents/skills/cloudflare/
agents/skills/cloudflare-email-service/
agents/skills/cloudflare-one/
agents/skills/cloudflare-one-migrations/
agents/skills/durable-objects/
agents/skills/sandbox-migrate-to-next/
agents/skills/sandbox-next/
agents/skills/sandbox-stable/
agents/skills/turnstile-spin/
agents/skills/web-perf/
agents/skills/workers-best-practices/
agents/skills/wrangler/

# Skills sourced from a sibling repo via symlink
agents/skills/team

# Dolt database files (added by bd init)
.dolt/
*.db

# Beads export state (machine-local sync cursor)
.beads/export-state.json
