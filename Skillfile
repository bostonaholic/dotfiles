#!/usr/bin/env bash
# Skillfile — third-party and personal agent skills, installed globally.
#
# Run: ./Skillfile   (install.sh and update.sh both invoke this)
#
# Third-party skills install for Claude Code and Codex. Local personal skills
# install for Codex only; Claude Code loads them from the local plugin.
# Claude-app-synced skills live in ~/.claude/skills/synced/.
# Managed elsewhere:
#   - cloudflare plugin skills are declared in dotfiles.yaml (claude.plugins)

set -euo pipefail

echo "Installing agent skills..."

# Anthropic official (frontend-design, skill-creator)
npx skills add anthropics/skills --skill frontend-design --skill skill-creator --agent claude-code codex -g -y

# Vercel (find-skills)
npx skills add vercel-labs/skills --skill find-skills --agent claude-code codex -g -y

# GitHub Copilot (create-agentsmd)
npx skills add github/awesome-copilot --skill create-agentsmd --agent claude-code codex -g -y

# Matt Pocock (grill-me)
npx skills add mattpocock/skills --skill grill-me --agent claude-code codex -g -y

# Akshat (first-principles-thinking)
npx skills add akshat10/skills --skill first-principles-thinking --agent claude-code codex -g -y

# Blader (humanizer)
npx skills add blader/humanizer --skill humanizer --agent claude-code codex -g -y

# Microsoft (playwright-cli)
npx skills add microsoft/playwright-cli --skill playwright-cli --agent claude-code codex -g -y

# Book to Skill (book-to-skill)
npx skills add virgiliojr94/book-to-skill --all -g -y

# Local personal skills for Codex (Claude Code installs them as a plugin)
npx skills add "$HOME/code/bostonaholic/skills/skills" --skill '*' --agent codex -g -y

echo "Done. Run 'npx skills list -g' to verify."
