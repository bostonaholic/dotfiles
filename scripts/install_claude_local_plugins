#!/usr/bin/env bash
set -euo pipefail

# Install plugins from local marketplaces. Claude Code reads local plugin files
# directly, so edits take effect after restarting or reloading plugins.

declare -A LOCAL_PLUGINS=(
  # source_dir -> plugin@marketplace
  ["$HOME/code/bostonaholic/team"]="team@team-dev"
  ["$HOME/code/bostonaholic/skills"]="bostonaholic-skills@bostonaholic"
)

for source in "${!LOCAL_PLUGINS[@]}"; do
  plugin="${LOCAL_PLUGINS[$source]}"

  if [[ ! -d "$source" ]]; then
    echo "  [skip] $source does not exist"
    continue
  fi

  # Add as marketplace if not already present
  marketplace="${plugin#*@}"
  if ! claude plugin marketplace list | awk -v name="$marketplace" '$1 == "❯" && $2 == name { found=1 } END { exit !found }'; then
    echo "  [add]  marketplace $marketplace from $source"
    claude plugin marketplace add "$source"
  fi

  # Install plugin if not already installed
  if ! claude plugin list | awk -v name="$plugin" '$1 == "❯" && $2 == name { found=1 } END { exit !found }'; then
    echo "  [install] $plugin"
    claude plugin install "$plugin"
  fi
done
