# Silence zoxide's "configuration issue" doctor banner. It fires on every
# non-interactive shell (e.g. Claude Code's Bash tool re-sources config per
# call), even though zoxide is already initialized correctly at the end of
# zshrc. Lives in .zshenv so it applies to non-interactive shells too.
export _ZO_DOCTOR=0

# Aliases that shadow standard commands belong at a prompt, not in shells that
# tools drive through this config expecting POSIX behavior. Interactivity alone
# is not enough -- agents capture this config from an interactive shell.
typeset -g ZSH_INTERACTIVE_ALIASES=0
if [[ -o interactive ]] &&
   [[ -z "${CLAUDECODE-}${CLAUDE_CODE_ENTRYPOINT-}${AI_AGENT-}${CURSOR_AGENT-}${CODEX_SANDBOX-}" ]]; then
  ZSH_INTERACTIVE_ALIASES=1
fi
