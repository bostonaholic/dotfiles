#!/usr/bin/env zsh

# Runs for every zsh, scripts included: environment variables only, no output.

# :A resolves the ~/.zshenv symlink, so this finds path.zsh beside this file.
source "${${(%):-%x}:A:h}/path.zsh"

# XDG Base Directory
export XDG_BIN_HOME="$HOME/.local/bin"
export XDG_CACHE_HOME="$HOME/Library/Caches"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_RUNTIME_DIR="$TMPDIR/runtime-$UID"
export XDG_STATE_HOME="$HOME/.local/state"

export EDITOR='vim'

# -R shows color escapes (git diff, git log) as colors.
# --quit-if-one-screen exits when the content fits on one screen, and
# --no-init keeps that content on screen after less exits.
export LESS="-R --quit-if-one-screen --no-init $LESS"

# A shell driven by a coding agent has nobody to answer a prompt, so commands
# that would open an editor, a pager or a question must return instead.
if [[ -n "${CLAUDECODE-}${CLAUDE_CODE_ENTRYPOINT-}${AI_AGENT-}${CURSOR_AGENT-}${CODEX_SANDBOX-}" ]]; then
  export DOTFILES_AGENT_SHELL=1
  export GIT_EDITOR=true GIT_PAGER=cat PAGER=cat GH_PROMPT_DISABLED=1
fi
