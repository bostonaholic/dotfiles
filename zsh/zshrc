#!/usr/bin/env zsh

# History
HISTSIZE=100000
SAVEHIST=100000
setopt extended_history hist_expire_dups_first hist_ignore_dups \
  hist_ignore_space hist_verify share_history

# Agent shells share no history file with the person, and skip loading it.
# zsh has no default HISTFILE, so a person shell on a system that sets none
# (Linux) gets the path macOS /etc/zshrc uses.
if [[ -n "${DOTFILES_AGENT_SHELL-}" ]]; then
  unset HISTFILE
elif [[ -z "${HISTFILE-}" ]]; then
  HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
fi

# Key bindings
bindkey -e

# /etc/zshrc binds these keys in the viins keymap when EDITOR contains vi,
# so bind them again in the emacs keymap that bindkey -e selects.
# Up and Down use the beginning-search widgets, which match the whole typed
# prefix and leave the cursor at the end of the line. terminfo gives the
# application-mode arrow sequences, which a terminal sends only after smkx,
# and nothing here sends smkx, so ^[[A and ^[[B are bound as well.
zmodload zsh/terminfo
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
[[ -n "${terminfo[kdch1]}" ]] && bindkey "${terminfo[kdch1]}" delete-char
[[ -n "${terminfo[khome]}" ]] && bindkey "${terminfo[khome]}" beginning-of-line
[[ -n "${terminfo[kend]}" ]] && bindkey "${terminfo[kend]}" end-of-line
[[ -n "${terminfo[kcuu1]}" ]] && bindkey "${terminfo[kcuu1]}" up-line-or-beginning-search
[[ -n "${terminfo[kcud1]}" ]] && bindkey "${terminfo[kcud1]}" down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search

# Completion, for a person at a prompt only: it costs about 0.3s per shell.
if [[ -z "${DOTFILES_AGENT_SHELL-}" ]]; then
  autoload -Uz compinit && compinit
  command -v op >/dev/null && eval "$(op completion zsh)"
fi

# Prompt: git's own git-prompt.sh, for a person at a prompt only. The first
# path that exists wins: Homebrew, Apple Command Line Tools, Debian/Ubuntu,
# Fedora/RHEL, Arch. With none found, zsh keeps its default prompt.
if [[ -o interactive && -z "${DOTFILES_AGENT_SHELL-}" ]]; then
  for git_prompt in \
    "${HOMEBREW_PREFIX:-/opt/homebrew}/etc/bash_completion.d/git-prompt.sh" \
    /Library/Developer/CommandLineTools/usr/share/git-core/git-prompt.sh \
    /usr/lib/git-core/git-sh-prompt \
    /usr/share/git-core/contrib/completion/git-prompt.sh \
    /usr/share/git/completion/git-prompt.sh; do
    if [[ -r "$git_prompt" ]]; then
      source "$git_prompt"
      GIT_PS1_SHOWDIRTYSTATE=1
      GIT_PS1_SHOWCOLORHINTS=1
      autoload -Uz add-zsh-hook
      dotfiles_git_prompt() { __git_ps1 "%m:%~" " %# " " (%s)"; }
      add-zsh-hook precmd dotfiles_git_prompt
      break
    fi
  done
  unset git_prompt
fi

# Agent guard: aliases that change what a command does belong at a prompt,
# not in shells that agents drive. Agents capture this config from an
# interactive shell, so interactivity alone is not enough.
typeset -g ZSH_INTERACTIVE_ALIASES=0
if [[ -o interactive && -z "${DOTFILES_AGENT_SHELL-}" ]]; then
  ZSH_INTERACTIVE_ALIASES=1
fi

# CLI
alias ..="cd .."

# Claude
if (( ZSH_INTERACTIVE_ALIASES )); then
    alias claude="caffeinate -di claude --dangerously-skip-permissions"
    alias cc="claude"
fi

alias rgrep="grep --recursive"

alias date_seconds="date +%s"
alias rand="date | md5"

alias camera_restart="sudo killall VDCAssistant"

if (( ZSH_INTERACTIVE_ALIASES )); then
    alias ip="curl https://icanhazip.com"
fi

alias iso8601_date="date +%Y-%m-%dT%H:%M:%S%z"

alias upcase="tr '[:lower:]' '[:upper:]'"
alias downcase="tr '[:upper:]' '[:lower:]'"

# Git
alias gti=git

# Ruby
function bundle_close() {
    bundle exec gem pristine "$*"
}

# Python
if (( ZSH_INTERACTIVE_ALIASES )); then
    alias python=python3
fi

# Clojure
function cljs() {
    planck "$*"
}
