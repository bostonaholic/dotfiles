#!/usr/bin/env zsh

# History
HISTSIZE=50000
SAVEHIST=10000
setopt extended_history hist_expire_dups_first hist_ignore_dups \
  hist_ignore_space hist_verify share_history

# Misc
export EDITOR='vim'
bindkey -e

# /etc/zshrc binds these keys in the viins keymap when EDITOR contains vi,
# so bind them again in the emacs keymap that bindkey -e selects.
zmodload zsh/terminfo
[[ -n "${terminfo[kdch1]}" ]] && bindkey "${terminfo[kdch1]}" delete-char
[[ -n "${terminfo[khome]}" ]] && bindkey "${terminfo[khome]}" beginning-of-line
[[ -n "${terminfo[kend]}" ]] && bindkey "${terminfo[kend]}" end-of-line
[[ -n "${terminfo[kcuu1]}" ]] && bindkey "${terminfo[kcuu1]}" up-line-or-search
[[ -n "${terminfo[kcud1]}" ]] && bindkey "${terminfo[kcud1]}" down-line-or-search

# 1Password SSH agent
export SSH_AUTH_SOCK=~/.1password/agent.sock

# Added for dev
if [[ -d "$HOME/code/bostonaholic/dev/bin" ]]; then
  export PATH="$HOME/code/bostonaholic/dev/bin:$PATH"
fi
