#!/usr/bin/env bash
################################################################################
# Git AI Commit Message Generator
#
# DESCRIPTION:
#   Generates commit messages using Apple's on-device model (fm) without
#   creating commits.
#   Analyzes staged changes and outputs a conventional commit message to stdout.
#   Non-interactive - suitable for git hooks and automation.
#
# USAGE:
#   git ai-commit-msg [optional-context]
#
# ARGUMENTS:
#   optional-context  - Additional context to guide message generation
#
# EXAMPLES:
#   git ai-commit-msg                        # Generate message
#   git ai-commit-msg "Refactoring for performance"  # With context
#   git commit -m "$(git ai-commit-msg)"     # Use in git command
#
# COMMIT MESSAGE FORMAT:
#   Follows conventional commit format:
#   - type(scope): description
#   - Types: feat, fix, docs, style, refactor, test, chore
#   - First line under 72 characters
#   - Focus on WHY, not just WHAT
#   - Imperative mood (add, not added/adds)
#
# EXIT CODES:
#   0 - Success (message generated)
#   1 - Error (not in git repo, no staged changes, fm not available)
#   Other non-zero - fm failed (69: run 'sudo fm license')
#
# DEPENDENCIES:
#   - git (with staged changes)
#   - fm (Apple's Foundation Models CLI, macOS 27 on Apple silicon)
#
# NOTES:
#   Output goes to stdout, errors to stderr.
#   Input to fm is capped at 8,000 characters; longer diffs are truncated.
#   Used by git-ai-commit for interactive workflow.
#
################################################################################

set -euo pipefail

# Get optional user context from first argument
USER_CONTEXT="${1:-}"

# Check if we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    exit 1
fi

# Check if there are staged changes
if git diff --cached --quiet; then
    exit 1
fi

# Check if Apple's fm CLI is available
if ! command -v fm &> /dev/null; then
    echo "fm not found: requires macOS 27 on Apple silicon" >&2
    exit 1
fi

# fm's 4,096-token limit covers instructions, input and answer. Cap the input
# so the three fit.
MAX_INPUT_CHARS=8000

# Changed-file summary first, so a truncated diff still names every file
# (filter out null bytes)
STAT=$(git diff --cached --stat | tr -d '\000')
DIFF=$(git diff --cached | tr -d '\000')
INPUT="${STAT}

${DIFF}"
INPUT="${INPUT:0:MAX_INPUT_CHARS}"

# Get recent commit messages for context (filter out null bytes)
RECENT_COMMITS=$(git log --format='%s' -5 2>/dev/null | tr -d '\000' || echo "")

INSTRUCTIONS="You are a git commit message expert. The input is a staged git diff, preceded by a summary of changed files. Generate a concise, meaningful commit message.

Follow these guidelines:
1. Use conventional commit format: type(scope): description
   - Types: feat, fix, docs, style, refactor, test, chore
   - Scope is optional but encouraged
2. Keep the first line under 72 characters
3. Focus on WHY the change was made, not just WHAT changed
4. Be specific and avoid vague messages like 'update files' or 'fix bug'
5. Use imperative mood (e.g., 'add' not 'added' or 'adds')

Here are recent commits from this repository for style reference:
${RECENT_COMMITS}"

# Add user context if provided
if [ -n "$USER_CONTEXT" ]; then
    INSTRUCTIONS="${INSTRUCTIONS}

Additional context from the developer:
${USER_CONTEXT}"
fi

INSTRUCTIONS="${INSTRUCTIONS}

Generate ONLY the raw commit message text. Do NOT wrap it in markdown code fences, backticks, or any formatting. Do NOT add explanations or commentary. Output the commit message exactly as it should appear in the git log. If the change is complex, you may use a multi-line message with a blank line separating the subject from the body."

# The diff goes on stdin: fm discards stdin when given a positional prompt.
printf '%s' "$INPUT" | fm respond --no-stream --instructions "$INSTRUCTIONS"
