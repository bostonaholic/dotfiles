{
  "env": {
    "MAX_THINKING_TOKENS": "31999",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/statusline.sh"
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": true,
    "team@team-dev": true,
    "bostonaholic@skills": true,
    "dev@dev": true,
    "cloudflare@cloudflare": true,
    "typescript-lsp@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "bostonaholic@claude-mods": true
  },
  "extraKnownMarketplaces": {
    "team-dev": {
      "source": {
        "source": "github",
        "repo": "bostonaholic/team"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "skills": {
      "source": {
        "source": "github",
        "repo": "bostonaholic/skills"
      }
    },
    "dev": {
      "source": {
        "source": "github",
        "repo": "bostonaholic/dev"
      }
    },
    "claude-mods": {
      "source": {
        "source": "github",
        "repo": "bostonaholic/claude-mods"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "opus": {
      "effortLevel": "medium"
    }
  },
  "fastModePerSessionOptIn": false,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "light",
  "teammateMode": "auto",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}
