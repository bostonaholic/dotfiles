{
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "MAX_THINKING_TOKENS": "31999"
  },
  "permissions": {
    "allow": [
      "Bash(claude plugin *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(git worktree list *)",
      "Bash(jq *)",
      "Bash(rg *)",
      "Bash(shellcheck *)",
      "Bash(wt ls)",
      "Bash(wt main)",
      "Bash(wt new *)",
      "Bash(wt path *)"
    ],
    "deny": [
      "Bash(git -c commit.gpgsign=false *)",
      "Bash(git commit *--no-gpg-sign*)",
      "Bash(git merge --no-ff *)",
      "Bash(git push * --force *)",
      "Bash(git push * --force)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push --force *)",
      "Bash(git push --force)",
      "Bash(git push -f *)",
      "Bash(git push -f)",
      "Bash(git stash pop *)",
      "Bash(git stash pop)",
      "Bash(git stash)",
      "Bash(git tag -a *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/statusline.sh"
  },
  "enabledPlugins": {
    "bostonaholic@claude-mods": true,
    "bostonaholic@skills": true,
    "cloudflare@cloudflare": true,
    "dev@dev": true,
    "egm@egm": true,
    "i-have-adhd@i-have-adhd": true,
    "playwright@claude-plugins-official": true,
    "team@team-dev": true,
    "typescript-lsp@claude-plugins-official": true,
    "vercel@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-mods": {
      "source": {
        "source": "github",
        "repo": "bostonaholic/claude-mods"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "dev": {
      "source": {
        "source": "github",
        "repo": "bostonaholic/dev"
      }
    },
    "egm": {
      "source": {
        "source": "github",
        "repo": "google/elephant-goldfish-model"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "skills": {
      "source": {
        "source": "github",
        "repo": "bostonaholic/skills"
      }
    },
    "team-dev": {
      "source": {
        "source": "directory",
        "path": "/Users/matthew/code/bostonaholic/team"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "opus": {
      "effortLevel": "medium"
    }
  },
  "fastModePerSessionOptIn": false,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "light",
  "teammateMode": "auto",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/bin/claude-notify"
          }
        ]
      }
    ]
  }
}
